-/* Local nRF52840 timestamp integration. See SOURCE.txt for ownership/ABI contract.
- * TIMER3 is the application's running 1 MHz, 32-bit Zephyr counter. Never
- * initialize, stop, clear, or software-capture it here. CC5 is reserved for END.
- */
-BUILD_ASSERT(IS_ENABLED(CONFIG_SOC_NRF52840), "ESB timestamps require nRF52840");
-BUILD_ASSERT(!IS_ENABLED(CONFIG_ESB_MPSL_TIMESLOT), "Timestamp timeslots unsupported");
-BUILD_ASSERT(CONFIG_ESB_SYS_TIMER_INSTANCE != 3, "TIMER3 belongs to the application");
-
-static nrfx_gppi_handle_t timestamp_conn;
-static nrfx_gppi_group_handle_t timestamp_group;
-static bool timestamp_allocated;
-static bool timestamp_armed;
-static volatile uint32_t data_tx_end_us;
-
-static uint32_t timestamp_event_addr(void)
-{
-	return nrf_radio_event_address_get(NRF_RADIO, NRF_RADIO_EVENT_END);
-}
-
-static uint32_t timestamp_task_addr(void)
-{
-	return nrf_timer_task_address_get(NRF_TIMER3, NRF_TIMER_TASK_CAPTURE5);
-}
-
-static int timestamp_init(void)
-{
-	int err;
-
-	if (nrf_timer_mode_get(NRF_TIMER3) != NRF_TIMER_MODE_TIMER ||
-	    nrf_timer_bit_width_get(NRF_TIMER3) != NRF_TIMER_BIT_WIDTH_32 ||
-	    nrf_timer_prescaler_get(NRF_TIMER3) != 4) {
-		return -EINVAL;
-	}
-
-	err = nrfx_gppi_conn_alloc(timestamp_event_addr(), timestamp_task_addr(), &timestamp_conn);
-	if (err) {
-		return err;
-	}
-	nrfx_gppi_conn_disable(timestamp_conn);
-	err = nrfx_gppi_group_alloc(0, &timestamp_group);
-	if (err) {
-		nrfx_gppi_conn_free(timestamp_event_addr(), timestamp_task_addr(), timestamp_conn);
-		return err;
-	}
-	/* PPI handles are channel numbers on nRF52840. Do not look up END's
-	 * channel by endpoint: ESB_NEVER_DISABLE_TX may also subscribe to END.
-	 */
-	nrfx_gppi_group_ch_add(timestamp_group, timestamp_conn);
-	err = nrfx_gppi_ep_attach(nrfx_gppi_group_task_dis_addr(timestamp_group), timestamp_conn);
-	if (err) {
-		nrfx_gppi_group_free(timestamp_group);
-		nrfx_gppi_conn_free(timestamp_event_addr(), timestamp_task_addr(), timestamp_conn);
-		return err;
-	}
-	timestamp_allocated = true;
-	timestamp_armed = false;
-	data_tx_end_us = 0;
-	return 0;
-}
-
-static void timestamp_disarm(void)
-{
-	if (timestamp_allocated) {
-		nrfx_gppi_group_disable(timestamp_group);
-	}
-	timestamp_armed = false;
-}
-
-static void timestamp_deinit(void)
-{
-	timestamp_disarm();
-	if (timestamp_allocated) {
-		nrfx_gppi_group_free(timestamp_group);
-		/* conn_free clears EEP, TEP and FORK, not just allocator ownership. */
-		nrfx_gppi_conn_free(timestamp_event_addr(), timestamp_task_addr(), timestamp_conn);
-		timestamp_allocated = false;
-	}
-}
-
-static void timestamp_arm(void)
-{
-	/* Called only immediately before data RX/TX, never before an ACK. END
-	 * captures CC5 and disables this same channel in hardware (one shot).
-	 */
-	nrf_radio_event_clear(NRF_RADIO, NRF_RADIO_EVENT_END);
-	timestamp_armed = true;
-	nrfx_gppi_group_enable(timestamp_group);
-}
-
-static uint32_t timestamp_take(void)
-{
-	/* A still-enabled channel means no END occurred in this window. Take
-	 * the snapshot before rearming; ACK END cannot overwrite frozen CC5.
-	 */
-	bool captured = timestamp_armed &&
-		(nrf_ppi_channel_enable_get(NRF_PPI, (nrf_ppi_channel_t)timestamp_conn) ==
-		 NRF_PPI_CHANNEL_DISABLED);
-
-	timestamp_disarm();
-	return captured ? nrf_timer_cc_get(NRF_TIMER3, NRF_TIMER_CC_CHANNEL5) : 0;
-}
-
-uint32_t esb_data_tx_end_us(void)
-{
-	return data_tx_end_us;
-}
-
