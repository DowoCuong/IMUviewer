-static void start_retx_in_new_timeslot(void)
-{
-#if NRF_TIMER_HAS_SHUTDOWN
-	nrf_timer_task_trigger(esb_timer.p_reg, NRF_TIMER_TASK_SHUTDOWN);
-#else
-	nrf_timer_task_trigger(esb_timer.p_reg, NRF_TIMER_TASK_STOP);
