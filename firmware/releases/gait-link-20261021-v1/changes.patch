-		if (IS_ENABLED(CONFIG_ESB_MPSL_TIMESLOT) && esb_cfg.mode == ESB_MODE_PRX) {
-			nrf_timer_task_trigger(ESB_NRF_TIMER_INSTANCE, NRF_TIMER_TASK_CAPTURE1);
