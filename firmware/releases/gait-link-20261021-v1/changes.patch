+static int start_wall_clock(void)
+{
+    if (!device_is_ready(wall_timer) || counter_get_frequency(wall_timer) != 1000000)
+        return -ENODEV;
+    /* Hold HFXO independently of USB and ESB's per-role clock references.
+     * Switching between HFRC and HFXO would invalidate the affine clock fit. */
+    struct onoff_manager *manager = z_nrf_clock_control_get_onoff(CLOCK_CONTROL_NRF_SUBSYS_HF);
+    static struct onoff_client client;
+    if (!manager) return -ENODEV;
+    sys_notify_init_spinwait(&client.notify);
+    int err = onoff_request(manager, &client), result;
+    if (err < 0) return err;
+    int64_t deadline = k_uptime_get() + 1000;
+    while ((err = sys_notify_fetch_result(&client.notify, &result)) == -EAGAIN) {
+        if (k_uptime_get() >= deadline) { err = -ETIMEDOUT; break; }
+        k_msleep(1);
+    }
+    if (!err) err = result;
+    if (!err) err = counter_start(wall_timer);
+    if (err) (void)onoff_cancel_or_release(manager, &client);
+    return err; /* Keep a successful reference for the application lifetime. */
+}
