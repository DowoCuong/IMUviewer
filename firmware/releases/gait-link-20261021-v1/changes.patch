-	err = nrfx_timer_init(&esb_timer, &config, esb_timer_handler);
-	if (err) {
-		LOG_ERR("Failed to initialize nrfx timer (err %d)", err);
-		return -EFAULT;
-	}
-
-	return 0;
-}
